            {"Tarte aux pommes", 4.50},
            {"Tarte au citron", 4.50},
            {"Glace vanille", 3.50},
            {"Glace chocolat", 3.50},
        }
    },
    
    -- Tâches planifiées
    scheduled_tasks = {
        hourly_date = true,      -- true pour activer /exec -o date chaque heure
    },
    
    -- Préfixe des commandes
    command_prefix = "!",       -- Peut être changé en ".", "&", etc.
    
    -- Configuration de la base de données PostgreSQL
    database = {
        enabled = false,         -- true pour activer PostgreSQL
        host = "localhost",      -- Adresse du serveur PostgreSQL
        port = 5432,             -- Port PostgreSQL
        database = "irc_bot",    -- Nom de la base de données
        user = "irc_user",       -- Nom d'utilisateur PostgreSQL
        password = "irc_password", -- Mot de passe PostgreSQL
        menus_table = "custom_menus", -- Nom de la table pour les menus
    },
    
    -- Configuration du module musique
    music = {
        enabled = false,         -- true pour activer le module musique
        -- Répertoire de stockage des fichiers audio
        music_dir = "/var/www/music",  -- Répertoire où les fichiers audio sont stockés
        -- URL base pour le streaming/téléchargement
        base_url = "https://music.yourdomain.tld", -- URL base du serveur nginx
        -- Paramètres de streaming
        streaming = {
            enabled = true,        -- true pour activer le streaming
            -- Chemin pour le streaming via nginx
            stream_path = "/stream",
            -- Chemin pour le téléchargement via nginx
            download_path = "/dl",
        },
        -- Limites
        max_file_size = 100 * 1024 * 1024, -- 100 Mo maximum
        allowed_extensions = {"mp3", "flac", "ogg", "m4a", "wav"}, -- Extensions autorisées
    },
